@model IEnumerable<DemoMVC.Models.Discipline>

@{
    ViewData["Title"] = "Danh sách ngành";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách ngành</h2>
    <button type="button" class="btn btn-primary" data-discipline-action="create">
        Tạo mới
    </button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" id="disciplineSearchInput" class="form-control"
               placeholder="Tìm theo tên ngành..."
               value="@ViewBag.SearchString"
               aria-label="Tìm kiếm ngành" />
    </div>
    <div class="col-auto">
        <button type="button" id="disciplineSearchButton" class="btn btn-outline-primary">
            Tìm kiếm
        </button>
    </div>
</div>

<div id="disciplineTableContainer">
    @await Html.PartialAsync("_DisciplineTable", Model)
</div>

<div class="modal fade" id="disciplineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="disciplineModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="disciplineModalBody"></div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="disciplineToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            const modalElement = document.getElementById("disciplineModal");
            const disciplineModal = bootstrap.Modal.getOrCreateInstance(modalElement);
            let currentSearch = $("#disciplineSearchInput").val().trim();
            let currentPage = @(ViewBag.CurrentPage ?? 1);

            function showToast(message, type) {
                const toast = $("#disciplineToast");
                toast.removeClass("text-bg-success text-bg-danger text-bg-warning")
                    .addClass("text-bg-" + (type || "success"));
                toast.find(".toast-body").text(message);
                bootstrap.Toast.getOrCreateInstance(toast[0]).show();
            }

            function loadDisciplineTable(page = 1, searchString = "") {
                currentPage = page;
                currentSearch = searchString;

                return $.get("@Url.Action("Table", "Discipline")", {
                    page: page,
                    pageSize: 5,
                    searchString: searchString
                })
                    .done(function (html) {
                        $("#disciplineTableContainer").html(html);
                    })
                    .fail(function () {
                        showToast("Không thể tải lại danh sách ngành.", "danger");
                    });
            }

            function showModal(title, url) {
                $("#disciplineModalTitle").text(title);
                $("#disciplineModalBody").html(
                    '<div class="text-center p-3"><div class="spinner-border" role="status" aria-label="Đang tải"></div></div>');
                disciplineModal.show();

                $.get(url)
                    .done(function (html) {
                        $("#disciplineModalBody").html(html);
                    })
                    .fail(function (xhr) {
                        disciplineModal.hide();
                        showToast(xhr.responseJSON?.message || "Không thể tải biểu mẫu.", "danger");
                    });
            }

            function submitDisciplineForm(form) {
                const submitButton = form.find(":submit");
                submitButton.prop("disabled", true);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    headers: {
                        "RequestVerificationToken":
                            form.find("input[name='__RequestVerificationToken']").val()
                    }
                })
                    .done(function (result) {
                        disciplineModal.hide();
                        showToast(result.message, "success");
                        loadDisciplineTable(1, currentSearch);
                    })
                    .fail(function (xhr) {
                        if (xhr.status === 400 && xhr.responseText) {
                            $("#disciplineModalBody").html(xhr.responseText);
                            return;
                        }

                        showToast(xhr.responseJSON?.message || "Không thể xử lý yêu cầu.", "danger");
                    })
                    .always(function () {
                        submitButton.prop("disabled", false);
                    });
            }

            $(document).on("click", "[data-discipline-action='create']", function () {
                showModal("Tạo ngành", "@Url.Action("Create", "Discipline")");
            });

            $(document).on("click", "[data-discipline-action='edit']", function () {
                const id = encodeURIComponent($(this).data("id"));
                showModal("Sửa ngành", "@Url.Action("Edit", "Discipline")?id=" + id);
            });

            $(document).on("click", "[data-discipline-action='delete']", function () {
                const id = encodeURIComponent($(this).data("id"));
                showModal("Xóa ngành", "@Url.Action("Delete", "Discipline")?id=" + id);
            });

            $("#disciplineSearchButton").on("click", function () {
                loadDisciplineTable(1, $("#disciplineSearchInput").val().trim());
            });

            $("#disciplineSearchInput").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    loadDisciplineTable(1, $(this).val().trim());
                }
            });

            $(document).on("click", "[data-discipline-page]", function () {
                if ($(this).closest(".page-item").hasClass("disabled")) {
                    return;
                }

                const page = Number($(this).data("discipline-page"));
                if (page > 0) {
                    loadDisciplineTable(page, currentSearch);
                }
            });

            $(document).on("submit", "#disciplineModalBody form", function (event) {
                event.preventDefault();
                submitDisciplineForm($(this));
            });
        })(jQuery);
    </script>
}
