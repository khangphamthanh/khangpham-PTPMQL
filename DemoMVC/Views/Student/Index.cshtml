@model DemoMVC.Models.Student
@using System.Text.Json

<h1>
    View Index SdudentController
</h1>

<ul>
    <li>1. Tạo form để gửi dữ liệu "Họ tên" từ View lên Controller</li>
    <li>2. Controller nhận dữ liệu từ View gửi lên và xử lý</li>
    <li>3. Hiển thị kết quả sau khi xử lý</li>
</ul>

<form asp-action="Index" method="post">
    <input type="text" name="FullName" placeholder="Nhập họ tên" />
    <input type="text" name="Address" placeholder="Nhập địa chỉ" />
    <input type="text" name="University" placeholder="Nhập trường học" />
    <input type="submit" value="Gửi dữ liệu" />
</form>


@if (Model != null)
{
    <span>Name: @Model.FullName</span> <br />
    <span>Address: @Model.Address</span> <br />
    <span>School: @Model.University</span> <br />
}

@if (ViewBag.TheStudent != null)
{
    <h3>Dữ liệu từ ViewBag/ViewData:</h3>
    Student st = (Student)ViewBag.TheStudent;
    <span>Name: @st.FullName</span> <br />
    <span>Address: @st.Address</span> <br />
    <span>School: @st.University</span> <br />
}

@if (TempData["TheStudent"] != null)
{
    <h3>Dữ liệu từ TempData:</h3>
    string jsonString = TempData["TheStudent"].ToString();
    Student st = JsonSerializer.Deserialize<Student>(jsonString);
    <span>Name: @st.FullName</span> <br />
    <span>Address: @st.Address</span> <br />
    <span>School: @st.University</span> <br />
}

