@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Students</h1>
    <button type="button" class="btn btn-primary" data-student-action="create">
        Create New
    </button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="search" id="studentSearchInput" class="form-control"
               placeholder="Tìm theo mã hoặc họ tên sinh viên..."
               value="@ViewBag.SearchString"
               aria-label="Tìm kiếm sinh viên" />
    </div>
    <div class="col-auto">
        <button type="button" id="studentSearchButton" class="btn btn-outline-primary">
            Tìm kiếm
        </button>
    </div>
</div>

<div id="studentTableContainer">
    @await Html.PartialAsync("_StudentTable", Model)
</div>

<div class="modal fade" id="studentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="studentModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="studentModalBody">
                <div class="text-center p-3">
                    <div class="spinner-border" role="status" aria-label="Loading"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="studentToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            const modalElement = document.getElementById("studentModal");
            const studentModal = bootstrap.Modal.getOrCreateInstance(modalElement);
            let currentSearch = $("#studentSearchInput").val().trim();
            let currentPage = @(ViewBag.CurrentPage ?? 1);

            function showToast(message, type) {
                const toast = $("#studentToast");
                toast.removeClass("text-bg-success text-bg-danger text-bg-warning")
                    .addClass("text-bg-" + (type || "success"));
                toast.find(".toast-body").text(message);
                bootstrap.Toast.getOrCreateInstance(toast[0]).show();
            }

            function loadStudentTable(page = 1, searchString = "") {
                currentPage = page;
                currentSearch = searchString;

                return $.get("@Url.Action("Table", "Student")", {
                    page: page,
                    pageSize: 5,
                    searchString: searchString
                })
                    .done(function (html) {
                        $("#studentTableContainer").html(html);
                    })
                    .fail(function () {
                        showToast("Không thể tải lại danh sách sinh viên.", "danger");
                    });
            }

            function showModal(title, url) {
                $("#studentModalTitle").text(title);
                $("#studentModalBody").html(
                    '<div class="text-center p-3"><div class="spinner-border" role="status" aria-label="Loading"></div></div>');
                studentModal.show();

                $.get(url)
                    .done(function (html) {
                        $("#studentModalBody").html(html);
                    })
                    .fail(function (xhr) {
                        studentModal.hide();
                        showToast(xhr.responseJSON?.message || "Không thể tải biểu mẫu.", "danger");
                    });
            }

            function submitStudentForm(form) {
                const submitButton = form.find(":submit");
                submitButton.prop("disabled", true);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    headers: {
                        "RequestVerificationToken":
                            form.find("input[name='__RequestVerificationToken']").val()
                    }
                })
                    .done(function (result) {
                        studentModal.hide();
                        showToast(result.message, "success");
                        loadStudentTable(1, currentSearch);
                    })
                    .fail(function (xhr) {
                        if (xhr.status === 400 && xhr.responseText) {
                            $("#studentModalBody").html(xhr.responseText);
                            return;
                        }

                        showToast(xhr.responseJSON?.message || "Không thể xử lý yêu cầu.", "danger");
                    })
                    .always(function () {
                        submitButton.prop("disabled", false);
                    });
            }

            $(document).on("click", "[data-student-action='create']", function () {
                showModal("Create Student", "@Url.Action("Create", "Student")");
            });

            $(document).on("click", "[data-student-action='edit']", function () {
                const id = encodeURIComponent($(this).data("id"));
                showModal("Edit Student", "@Url.Action("Edit", "Student")?id=" + id);
            });

            $(document).on("click", "[data-student-action='delete']", function () {
                const id = encodeURIComponent($(this).data("id"));
                showModal("Delete Student", "@Url.Action("Delete", "Student")?id=" + id);
            });

            $("#studentSearchButton").on("click", function () {
                loadStudentTable(1, $("#studentSearchInput").val().trim());
            });

            $("#studentSearchInput").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    loadStudentTable(1, $(this).val().trim());
                }
            });

            $(document).on("click", "[data-student-page]", function () {
                if ($(this).closest(".page-item").hasClass("disabled")) {
                    return;
                }

                const page = Number($(this).data("student-page"));
                if (page > 0) {
                    loadStudentTable(page, currentSearch);
                }
            });

            $(document).on("submit", "#studentModalBody form", function (event) {
                event.preventDefault();
                submitStudentForm($(this));
            });
        })(jQuery);
    </script>
}
