@model IEnumerable<DemoMVC.Models.Student>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Full Name</th>
            <th>Address</th>
            <th>University</th>
            <th>Department</th>
            <th>Discipline</th>
            <th>Form of Training</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentId</td>
                    <td>@item.FullName</td>
                    <td>@item.Address</td>
                    <td>@item.University</td>
                    <td>@item.Department?.DepartmentName</td>
                    <td>@item.Discipline?.DisciplineName</td>
                    <td>@item.FormOfTraining?.FormName</td>
                    <td class="text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-student-action="edit" data-id="@item.StudentId">
                            Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-student-action="delete" data-id="@item.StudentId">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">Không có dữ liệu phù hợp.</td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <small class="text-muted">
        Tổng số: @ViewBag.TotalRecords sinh viên
    </small>

    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Student pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                    <button type="button" class="page-link" data-student-page="@(ViewBag.CurrentPage - 1)"
                            aria-label="Previous">«</button>
                </li>

                @for (var pageNumber = 1; pageNumber <= ViewBag.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == ViewBag.CurrentPage ? "active" : "")">
                        <button type="button" class="page-link" data-student-page="@pageNumber">
                            @pageNumber
                        </button>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" data-student-page="@(ViewBag.CurrentPage + 1)"
                            aria-label="Next">»</button>
                </li>
            </ul>
        </nav>
    }
</div>
